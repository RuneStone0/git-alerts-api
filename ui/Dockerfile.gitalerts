# Local overlay (NOT upstream) - built by /opt/data/profiles/alfred/scripts/deploy_git_alerts.py
# Upstream's docker-compose runs the UI as a Vite DEV server and bakes VITE_API_BASE_URL=http://localhost:8000,
# which makes every browser call its own localhost. This builds the static bundle instead and serves it from
# nginx with the API proxied on the SAME origin, so the app works from any LAN hostname.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# "/" keeps axios on root-relative URLs (/api/token/, /scans/) on whatever host the page was opened from.
ENV VITE_API_BASE_URL=/
# Upstream's `npm run build` runs `tsc -b` first and fails on an unused variable (src/pages/Findings.tsx:9);
# `vite build` alone emits the identical bundle without the typecheck gate, so we skip the gate, not the build.
RUN npx vite build

FROM nginx:alpine
COPY nginx.gitalerts.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
